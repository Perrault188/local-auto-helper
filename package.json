{
  "name": "local-auto-helper",
  "version": "0.3.1",
  "private": false,
  "description": "本地优先的通用自动帮办演示项目",
  "type": "module",
  "scripts": {
    "start": "node demo/server.mjs",
    "test": "node --test tests/*.test.mjs tests/evaluation/*.test.mjs",
    "eval:m0:rule": "node tests/evaluation/evaluate-rule-intent.mjs",
    "eval:m0:safety": "node tests/evaluation/intent-safety-runner.mjs",
    "eval:m0:hygiene": "node tests/evaluation/intent-dataset-hygiene-probe.mjs",
    "eval:m0:probe": "node tests/evaluation/p2-m0-current-probe.mjs",
    "eval:m0:qwen": "node tests/evaluation/intent-qwen-runner.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
